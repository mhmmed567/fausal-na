# Frontend (publishable only — never put the service role here)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Local web → local MCP. On Hostinger/Netlify the site uses https://<domain>/mcp automatically.
# VITE_MCP_ENDPOINT=http://localhost:4010/mcp

# MCP server (backend only — never prefix these with VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtsdXVuc3ltZXpzdHNmcWhwbGN1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk1NjM5MTAsImV4cCI6MjEwNTEzOTkxMH0.-Jip9INoX_GODdN1Ju4HM4k--Ig1ab1occkZt1UjdZs
# Preferred: service role (bypasses RLS after MCP permission checks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Fallback when service role is not available: admin user session
MCP_SUPABASE_EMAIL=admin@nahdha.local
MCP_SUPABASE_PASSWORD=change-me
# Local only — Hostinger sets PORT automatically; do not hardcode 4010 in production
MCP_PORT=4010
MCP_PUBLIC_URL=http://localhost:4010/mcp
# On Hostinger, set MCP_PUBLIC_URL=https://YOUR_DOMAIN/mcp
# Also set SUPABASE_URL, SUPABASE_ANON_KEY, and either
# SUPABASE_SERVICE_ROLE_KEY or MCP_SUPABASE_EMAIL + MCP_SUPABASE_PASSWORD.
# Optional: dedicated secret for OAuth codes/tokens (defaults to service role / anon key)
# OAUTH_SIGNING_SECRET=long-random-string
